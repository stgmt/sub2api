{
  "name": "openai-grok-composite",
  "version": 1,
  "group_name": "headroom-openai-grok-composite",
  "expected_account_name": "codex-chatgpt-subscription",
  "secondary_account_name": "grok-build-subscription",
  "main_model": "gpt-5.6-sol",
  "expected_provider": "openai",
  "expected_account_type": "oauth",
  "agent_model": "gpt-5.6-luna",
  "agent_effort": "max",
  "unset_client_env": [
    "CLAUDE_CODE_EFFORT_LEVEL"
  ],
  "client_env": {
    "ANTHROPIC_MODEL": "gpt-5.6-sol",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gpt-5.6-sol",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "GPT-5.6 Sol",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "gpt-5.6-luna",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "GPT-5.6 Luna",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gpt-5.6-luna",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "GPT-5.6 Luna",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gpt-5.6-luna",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "GPT-5.6 Luna",
    "ANTHROPIC_SMALL_FAST_MODEL": "gpt-5.6-luna",
    "CLAUDE_CODE_SUBAGENT_MODEL": "gpt-5.6-luna",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "10",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "370000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "340000"
  },
  "group": {
    "name": "headroom-openai-grok-composite",
    "description": "Headroom composite catalog: selected GPT/Codex models use the OpenAI OAuth account and selected Grok models use the Grok OAuth account. No automatic provider or model fallback.",
    "platform": "openai",
    "rate_multiplier": 1.0,
    "is_exclusive": false,
    "subscription_type": "standard",
    "claude_code_only": true,
    "fallback_group_id": null,
    "fallback_group_id_on_invalid_request": null,
    "model_routing": {},
    "model_routing_enabled": false,
    "mcp_xml_inject": true,
    "allow_messages_dispatch": true,
    "require_oauth_only": true,
    "require_privacy_set": false,
    "default_mapped_model": "gpt-5.6-sol",
    "rpm_limit": 0,
    "messages_dispatch_model_config": {},
    "models_list_config": {
      "enabled": true,
      "explicit": true,
      "models": [
        "gpt-5.6-sol",
        "gpt-5.6-luna",
        "gpt-5.6",
        "gpt-5.3-codex-spark",
        "gpt-5.3-codex-spark-fast",
        "gpt-5.3-codex",
        "gpt-5.3-codex-fast",
        "gpt-5.5",
        "gpt-5.5-fast",
        "gpt-5.4",
        "gpt-5.4-fast",
        "gpt-5.4-mini",
        "gpt-5.4-mini-fast",
        "gpt-5.2",
        "gpt-5.2-fast",
        "grok-4.6",
        "grok-4.5"
      ]
    }
  }
}
