# Copy this file to .env before running docker compose.
# The setup skill script can generate this file for you.

# Headroom is the Claude Code-facing endpoint.
HEADROOM_VERSION=0.31.0
HEADROOM_PYTHON_VERSION=3.12
HEADROOM_GIT_REPO=https://github.com/stgmt/headroom.git
HEADROOM_GIT_REF=df029ae44661593bfb538f240bbdfc17333d87d6
HEADROOM_RUST_TOOLCHAIN=1.88.0
HEADROOM_ACCELERATOR=cuda
HEADROOM_DOCKER_TARGET=gpu
HEADROOM_REQUIRE_CUDA=1
HEADROOM_KOMPRESS_BACKEND=auto
HEADROOM_TORCH_VERSION=2.11.0+cu128
HEADROOM_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
HEADROOM_BIND_HOST=127.0.0.1
HEADROOM_PORT=8787
SUB2API_STATE_ROOT=./data
SUB2API_PRIMARY_DNS=1.1.1.1
SUB2API_FALLBACK_DNS=8.8.8.8
HEADROOM_RTK_WIRING=enabled
HEADROOM_RTK_STATE_ROOT=./data/rtk
HEADROOM_SAVINGS_PROFILE=agent-90
HEADROOM_TARGET_RATIO=0.10
HEADROOM_RPM=6000
HEADROOM_TPM=100000000
HEADROOM_RETRY_MAX_ATTEMPTS=10
HEADROOM_UPSTREAM_429_HOLD_ENABLED=1
HEADROOM_UPSTREAM_429_MAX_WAIT_SECONDS=86400
HEADROOM_UPSTREAM_TRANSIENT_MAX_WAIT_SECONDS=86400
HEADROOM_UPSTREAM_429_HEARTBEAT_SECONDS=15
HEADROOM_UPSTREAM_429_DEFAULT_RETRY_SECONDS=30
HEADROOM_UPSTREAM_RECOVERY_HOLD_STATUSES=429,502,503,504,529
HEADROOM_CLAUDE_STREAM_RECOVERY=1
HEADROOM_CLAUDE_STREAM_RECOVERY_TTL_SECONDS=900
HEADROOM_CLAUDE_STREAM_RECOVERY_MAX_ATTEMPTS=3
HEADROOM_FORCE_KOMPRESS=1
HEADROOM_ACCURACY_GUARD=strict
HEADROOM_CODE_AWARE_ENABLED=1
HEADROOM_CONTEXT_TOOL=rtk
HEADROOM_RTK_GAIN_SCOPE=global
HEADROOM_COMPRESS_USER_MESSAGES=0
HEADROOM_COMPRESS_SYSTEM_MESSAGES=0
HEADROOM_PROTECT_ANALYSIS_CONTEXT=1
HEADROOM_PROTECT_READS=0
HEADROOM_PROTECT_RECENT=2
HEADROOM_MIN_TOKENS=120
HEADROOM_MAX_ITEMS=8
HEADROOM_DEDUPE=0
HEADROOM_TOOL_SEARCH=0
HEADROOM_LOSSLESS_THEN_LOSSY=0
HEADROOM_OUTPUT_SHAPER=1
HEADROOM_EFFORT_ROUTER=0
HEADROOM_OUTPUT_HOLDOUT=0
HEADROOM_REQUEST_TIMEOUT_SECONDS=900
HEADROOM_ANTHROPIC_PRE_UPSTREAM_CONCURRENCY=8
HEADROOM_COMPRESSION_MAX_WORKERS=2
HEADROOM_KOMPRESS_EXECUTION_TIMEOUT_MS=60000
HEADROOM_COMPRESSION_TIMEOUT_SECONDS=120
HEADROOM_COMPRESSION_DEADLINE_MS=90000
HEADROOM_MID_TURN_STREAM_WAIT_MS=600000
HEADROOM_CLAUDE_CODE_HANDLER_WATCHDOG_MS=540000
HEADROOM_KOMPRESS_MAX_CONCURRENT=2
HEADROOM_KOMPRESS_ONNX_INTRA_THREADS=2
HEADROOM_KOMPRESS_ONNX_INTER_THREADS=1
HEADROOM_KOMPRESS_BATCH_SIZE=16

# sub2api stays exposed for admin UI, diagnostics, and non-Claude clients.
SUB2API_BIND_HOST=127.0.0.1
SUB2API_PORT=18081
SUB2API_IMAGE=sub2api-codex:local-token-usage
SUB2API_GIT_REPO=https://github.com/stgmt/sub2api.git
SUB2API_GIT_REF=local
SUB2API_BUILD_CONTEXT=../..
SUB2API_DOCKERFILE=Dockerfile
SUB2API_GOPROXY=https://proxy.golang.org,direct
SUB2API_GOSUMDB=sum.golang.org
SUB2API_SERVER_SHUTDOWN_TIMEOUT=85s
SUB2API_OPENAI_CODEX_AUTH_FILE=/app/data/codex-auth.json
# Optional host-side Grok Build CLI auth source. The watchdog reads this file
# without printing secrets and syncs it into the existing Grok account.
SUB2API_GROK_BUILD_AUTH_FILE=
SUB2API_GROK_ACCOUNT_NAME=grok-build-subscription
SUB2API_GROK_CLI_BASE_URL=https://cli-chat-proxy.grok.com/v1

# Startup dependency wait: after a Docker daemon restart `restart:
# unless-stopped` starts all containers concurrently, so postgres/redis may
# still be booting when sub2api tries to acquire the migrations lock. These
# knobs bound the TCP wait loop (60 attempts x 2s = up to 120s by default).
SUB2API_DEPENDENCY_WAIT_ATTEMPTS=60
SUB2API_DEPENDENCY_WAIT_INTERVAL_SECONDS=2
GATEWAY_OPENAI_WS_MODE_ROUTER_V2_ENABLED=true
GATEWAY_OPENAI_WS_INGRESS_MODE_DEFAULT=ctx_pool

TZ=UTC
RUN_MODE=simple
SIMPLE_MODE_CONFIRM=true
SERVER_MODE=release
LOG_LEVEL=info
DATA_DIR=/app/data
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true

ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=change_this_admin_password

JWT_SECRET=change_this_to_a_long_random_jwt_secret
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=change_this_to_a_32_byte_or_longer_totp_key

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=sub2api
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

REDIS_PASSWORD=change_this_redis_password
REDIS_DB=0
REDIS_POOL_SIZE=256
REDIS_MIN_IDLE_CONNS=10
REDIS_ENABLE_TLS=false
